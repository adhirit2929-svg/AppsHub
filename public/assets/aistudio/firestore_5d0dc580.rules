rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Global Hardened Primitives ----------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAccountKey(accountKey) {
      return accountKey is string && accountKey.size() >= 2 && accountKey.size() <= 40 && accountKey.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBucketName(bucketName) {
      return bucketName in ['customApps', 'notes', 'stocks', 'meditation', 'shortcuts', 'appPrivacy', 'calculator', 'nutritrack'];
    }

    function isValidTwoParticipants(parts, pairId) {
      return parts is list
        && parts.size() == 2
        && parts[0] is string
        && parts[1] is string
        && isValidId(parts[0])
        && isValidId(parts[1])
        && parts[0] != parts[1]
        && parts[0] < parts[1]
        && pairId == (parts[0] + '__' + parts[1]);
    }

    // ---------- Entity Validation Blueprints ----------
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['ownerId', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'photoUrl', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['ownerId', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'email', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOnlineHubAccount(data, accountKey) {
      return data.keys().hasAll(['ownerId', 'accountKey', 'username', 'displayName', 'accountType', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'accountKey', 'username', 'displayName', 'avatar', 'accountType', 'theme', 'agentDataPerm', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.accountKey is string
        && isValidAccountKey(data.accountKey)
        && data.accountKey == accountKey
        && data.username is string
        && data.username.size() >= 2
        && data.username.size() <= 40
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 2048))
        && data.accountType == 'online'
        && (!('theme' in data) || data.theme in ['light', 'dark'])
        && (!('agentDataPerm' in data) || data.agentDataPerm is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOnlineDataBucket(data, accountKey, bucketName) {
      return data.keys().hasAll(['ownerId', 'accountKey', 'bucketName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'accountKey', 'bucketName', 'items', 'settings', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.accountKey is string
        && isValidAccountKey(data.accountKey)
        && data.accountKey == accountKey
        && data.bucketName is string
        && isValidBucketName(data.bucketName)
        && data.bucketName == bucketName
        && (!('items' in data) || (
          data.items is list
          && data.items.size() <= 200
          && (data.items.size() == 0 || data.items[0] is map)
        ))
        && (!('settings' in data) || (
          data.settings is map
          && data.settings.keys().size() <= 100
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['uid', 'usernameKey', 'username', 'grantedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'usernameKey', 'username', 'grantedBy', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == adminUid
        && data.usernameKey is string
        && isValidAccountKey(data.usernameKey)
        && data.username is string
        && data.username.size() >= 2
        && data.username.size() <= 40
        && data.grantedBy is string
        && isValidId(data.grantedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminInvite(data, usernameKey) {
      return data.keys().hasAll(['usernameKey', 'targetUsername', 'invitedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['usernameKey', 'targetUsername', 'invitedByUid', 'createdAt', 'updatedAt'])
        && data.usernameKey is string
        && isValidAccountKey(data.usernameKey)
        && data.usernameKey == usernameKey
        && data.targetUsername is string
        && data.targetUsername.size() >= 2
        && data.targetUsername.size() <= 40
        && data.invitedByUid is string
        && isValidId(data.invitedByUid)
        && data.invitedByUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOnlineProfile(data, usernameKey) {
      return data.keys().hasAll(['ownerId', 'usernameKey', 'username', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'usernameKey', 'username', 'displayName', 'avatar', 'role', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.usernameKey is string
        && isValidAccountKey(data.usernameKey)
        && data.usernameKey == usernameKey
        && data.username is string
        && data.username.size() >= 2
        && data.username.size() <= 40
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 2048))
        && data.role in ['user', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFriendship(data, pairId) {
      return data.keys().hasAll(['pairId', 'participants', 'requesterId', 'status', 'profiles', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['pairId', 'participants', 'requesterId', 'status', 'profiles', 'createdAt', 'updatedAt'])
        && data.pairId is string
        && isValidId(data.pairId)
        && data.pairId == pairId
        && isValidTwoParticipants(data.participants, pairId)
        && data.requesterId is string
        && isValidId(data.requesterId)
        && data.requesterId in data.participants
        && data.status in ['pending', 'accepted']
        && data.profiles is map
        && data.profiles.keys().size() == 2
        && data.profiles[data.participants[0]] is map
        && data.profiles[data.participants[1]] is map
        && data.profiles[data.participants[0]].keys().size() <= 6
        && data.profiles[data.participants[1]].keys().size() <= 6
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatThread(data, chatId) {
      return data.keys().hasAll(['chatId', 'participants', 'profiles', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['chatId', 'participants', 'profiles', 'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'createdAt', 'updatedAt'])
        && data.chatId is string
        && isValidId(data.chatId)
        && data.chatId == chatId
        && isValidTwoParticipants(data.participants, chatId)
        && data.profiles is map
        && data.profiles.keys().size() == 2
        && data.profiles[data.participants[0]] is map
        && data.profiles[data.participants[1]] is map
        && data.profiles[data.participants[0]].keys().size() <= 6
        && data.profiles[data.participants[1]].keys().size() <= 6
        && (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 500))
        && (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128))
        && (!('lastMessageAt' in data) || data.lastMessageAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, chatId, messageId) {
      return data.keys().hasAll(['messageId', 'chatId', 'participants', 'senderId', 'senderUsername', 'senderDisplayName', 'text', 'createdAt'])
        && data.keys().hasOnly(['messageId', 'chatId', 'participants', 'senderId', 'senderUsername', 'senderDisplayName', 'text', 'createdAt'])
        && data.messageId is string
        && isValidId(data.messageId)
        && data.messageId == messageId
        && data.chatId is string
        && isValidId(data.chatId)
        && data.chatId == chatId
        && isValidTwoParticipants(data.participants, chatId)
        && data.senderId is string
        && isValidId(data.senderId)
        && data.senderId == request.auth.uid
        && data.senderId in data.participants
        && data.senderUsername is string
        && data.senderUsername.size() >= 2
        && data.senderUsername.size() <= 40
        && data.senderDisplayName is string
        && data.senderDisplayName.size() >= 1
        && data.senderDisplayName.size() <= 60
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidSystemAnnouncement(data, docId) {
      return docId == 'announcement'
        && data.keys().hasAll(['message', 'updatedBy', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['message', 'updatedBy', 'active', 'createdAt', 'updatedAt'])
        && data.message is string
        && data.message.size() <= 500
        && data.updatedBy is string
        && data.updatedBy.size() >= 1
        && data.updatedBy.size() <= 80
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Health check doc for testConnection()
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // ---------- /admins/{adminUid} ----------
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(adminUid)
        && isVerifiedUser()
        && isValidAdminRecord(incoming(), adminUid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            request.auth.uid == adminUid
            && exists(/databases/$(database)/documents/adminInvites/$(incoming().usernameKey))
            && exists(/databases/$(database)/documents/onlineProfiles/$(incoming().usernameKey))
            && get(/databases/$(database)/documents/onlineProfiles/$(incoming().usernameKey)).data.ownerId == request.auth.uid
          )
        );

      allow update: if isValidId(adminUid)
        && isAdmin()
        && isValidAdminRecord(incoming(), adminUid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['usernameKey', 'username', 'grantedBy', 'updatedAt']);

      allow delete: if isValidId(adminUid) && isAdmin();
    }

    // ---------- /adminInvites/{usernameKey} ----------
    match /adminInvites/{usernameKey} {
      allow get: if isValidAccountKey(usernameKey) && isVerifiedUser();
      allow list: if isAdmin();

      allow create: if isValidAccountKey(usernameKey)
        && isAdmin()
        && isValidAdminInvite(incoming(), usernameKey)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidAccountKey(usernameKey)
        && isAdmin()
        && isValidAdminInvite(incoming(), usernameKey)
        && incoming().usernameKey == existing().usernameKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['targetUsername', 'invitedByUid', 'updatedAt']);

      allow delete: if isValidAccountKey(usernameKey) && isAdmin();
    }

    // ---------- /onlineProfiles/{usernameKey} ----------
    match /onlineProfiles/{usernameKey} {
      allow get: if isValidAccountKey(usernameKey) && isVerifiedUser();
      allow list: if isAdmin();

      allow create: if isValidAccountKey(usernameKey)
        && isVerifiedUser()
        && isValidOnlineProfile(incoming(), usernameKey)
        && incoming().ownerId == request.auth.uid
        && (incoming().role == 'user' || (incoming().role == 'admin' && isAdmin()))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidAccountKey(usernameKey)
        && isVerifiedUser()
        && isValidOnlineProfile(incoming(), usernameKey)
        && incoming().ownerId == existing().ownerId
        && incoming().usernameKey == existing().usernameKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'avatar', 'role', 'updatedAt']))
          || (
            existing().ownerId == request.auth.uid
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'avatar', 'updatedAt'])
          )
        );

      allow delete: if isValidAccountKey(usernameKey)
        && isVerifiedUser()
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // ---------- /friendships/{pairId} ----------
    match /friendships/{pairId} {
      allow get: if isValidId(pairId)
        && isVerifiedUser()
        && (
          pairId.matches('^' + request.auth.uid + '__.*$')
          || pairId.matches('^.*__' + request.auth.uid + '$')
        );

      allow list: if isVerifiedUser()
        && request.auth.uid in resource.data.participants;

      allow create: if isValidId(pairId)
        && isVerifiedUser()
        && isValidFriendship(incoming(), pairId)
        && incoming().requesterId == request.auth.uid
        && request.auth.uid in incoming().participants
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(pairId)
        && isVerifiedUser()
        && isValidFriendship(incoming(), pairId)
        && request.auth.uid in existing().participants
        && request.auth.uid != existing().requesterId
        && existing().status == 'pending'
        && incoming().status == 'accepted'
        && incoming().pairId == existing().pairId
        && incoming().participants == existing().participants
        && incoming().requesterId == existing().requesterId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isValidId(pairId)
        && isVerifiedUser()
        && (request.auth.uid in existing().participants || isAdmin());
    }

    // ---------- /chats/{chatId} ----------
    match /chats/{chatId} {
      allow get: if isValidId(chatId)
        && isVerifiedUser()
        && (
          chatId.matches('^' + request.auth.uid + '__.*$')
          || chatId.matches('^.*__' + request.auth.uid + '$')
        );

      allow list: if isVerifiedUser()
        && request.auth.uid in resource.data.participants;

      allow create: if isValidId(chatId)
        && isVerifiedUser()
        && isValidChatThread(incoming(), chatId)
        && request.auth.uid in incoming().participants
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            exists(/databases/$(database)/documents/friendships/$(chatId))
            && get(/databases/$(database)/documents/friendships/$(chatId)).data.status == 'accepted'
          )
        );

      allow update: if isValidId(chatId)
        && isVerifiedUser()
        && isValidChatThread(incoming(), chatId)
        && request.auth.uid in existing().participants
        && incoming().chatId == existing().chatId
        && incoming().participants == existing().participants
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['profiles', 'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'updatedAt']);

      allow delete: if isValidId(chatId)
        && isVerifiedUser()
        && (request.auth.uid in existing().participants || isAdmin());

      // ---------- /chats/{chatId}/messages/{messageId} ----------
      match /messages/{messageId} {
        allow get: if isValidId(chatId)
          && isValidId(messageId)
          && isVerifiedUser()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow list: if isVerifiedUser()
          && request.auth.uid in resource.data.participants
          && resource.data.chatId == chatId;

        allow create: if isValidId(chatId)
          && isValidId(messageId)
          && isVerifiedUser()
          && isValidChatMessage(incoming(), chatId, messageId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && incoming().participants == get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow update: if false;

        allow delete: if isValidId(chatId)
          && isValidId(messageId)
          && isVerifiedUser()
          && (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    // ---------- /systemConfig/{docId} ----------
    match /systemConfig/{docId} {
      allow get: if isValidId(docId) && isVerifiedUser();
      allow list: if false;

      allow create: if isValidId(docId)
        && isAdmin()
        && isValidSystemAnnouncement(incoming(), docId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(docId)
        && isAdmin()
        && isValidSystemAnnouncement(incoming(), docId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['message', 'updatedBy', 'active', 'updatedAt']);

      allow delete: if isValidId(docId) && isAdmin();
    }

    // ---------- /users/{userId} ----------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']);

      allow delete: if isValidId(userId) && isVerifiedOwner(userId);

      // ---------- PII Isolation: /users/{userId}/private/{docId} ----------
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isVerifiedOwner(userId);
        allow list: if false;

        allow create: if isValidId(userId)
          && docId == 'info'
          && isVerifiedOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && docId == 'info'
          && isVerifiedOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(docId) && isVerifiedOwner(userId);
      }

      // ---------- Online Hub Accounts: /users/{userId}/hubAccounts/{accountKey} ----------
      match /hubAccounts/{accountKey} {
        allow get: if isValidId(userId) && isValidAccountKey(accountKey) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidAccountKey(accountKey)
          && isVerifiedOwner(userId)
          && isValidOnlineHubAccount(incoming(), accountKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidAccountKey(accountKey)
          && isVerifiedOwner(userId)
          && isValidOnlineHubAccount(incoming(), accountKey)
          && incoming().ownerId == existing().ownerId
          && incoming().accountKey == existing().accountKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'avatar', 'theme', 'agentDataPerm', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidAccountKey(accountKey) && isVerifiedOwner(userId);

        // ---------- Data Buckets: /users/{userId}/hubAccounts/{accountKey}/buckets/{bucketName} ----------
        match /buckets/{bucketName} {
          allow get: if isValidId(userId)
            && isValidAccountKey(accountKey)
            && isValidBucketName(bucketName)
            && isOwner(userId)
            && exists(/databases/$(database)/documents/users/$(userId)/hubAccounts/$(accountKey))
            && get(/databases/$(database)/documents/users/$(userId)/hubAccounts/$(accountKey)).data.ownerId == request.auth.uid;

          allow list: if isValidId(userId)
            && isOwner(userId)
            && existing().ownerId == request.auth.uid
            && existing().accountKey == accountKey;

          allow create: if isValidId(userId)
            && isValidAccountKey(accountKey)
            && isValidBucketName(bucketName)
            && isVerifiedOwner(userId)
            && isValidOnlineDataBucket(incoming(), accountKey, bucketName)
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && exists(/databases/$(database)/documents/users/$(userId)/hubAccounts/$(accountKey))
            && get(/databases/$(database)/documents/users/$(userId)/hubAccounts/$(accountKey)).data.ownerId == request.auth.uid;

          allow update: if isValidId(userId)
            && isValidAccountKey(accountKey)
            && isValidBucketName(bucketName)
            && isVerifiedOwner(userId)
            && isValidOnlineDataBucket(incoming(), accountKey, bucketName)
            && incoming().ownerId == existing().ownerId
            && incoming().accountKey == existing().accountKey
            && incoming().bucketName == existing().bucketName
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['items', 'settings', 'updatedAt'])
            && exists(/databases/$(database)/documents/users/$(userId)/hubAccounts/$(accountKey))
            && get(/databases/$(database)/documents/users/$(userId)/hubAccounts/$(accountKey)).data.ownerId == request.auth.uid;

          allow delete: if isValidId(userId)
            && isValidAccountKey(accountKey)
            && isValidBucketName(bucketName)
            && isVerifiedOwner(userId);
        }
      }
    }
  }
}
